{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docscam.app/schema/pack-1.0.0.json",
  "title": "DocScam content pack",
  "type": "object",
  "required": ["schema_version", "content_version", "pack_id", "title", "locale", "questions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Shape of this document. Major bump = breaking; the app must refuse packs whose major version it does not implement."
    },
    "content_version": {
      "type": "string",
      "description": "Version of the content itself. Bump on any question edit so a stale cached pack is detectable."
    },
    "pack_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
    "source": { "type": "string" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt", "options", "correct_indices"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+-\\d{3}$" },
          "prompt": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "correct_indices": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0 }
          },
          "explanation": { "type": ["string", "null"] },
          "asset_image": {
            "type": ["string", "null"],
            "pattern": "^assets/"
          },
          "red_flag_rules": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Rule ids from scam-patterns.json. Links a practice question to the checker rules it teaches — the loop described in DR-001."
          }
        }
      }
    }
  }
}
