{
  "schema_version": "1.1.0",
  "pack_version": "2026.08.27c",
  "locale": "en-AU",
  "notes": "Red-flag pattern pack for ScamShield 'Check This'. Rules describe OBSERVED SCAM BEHAVIOUR, not verdicts. The engine reports which rules matched; it never concludes 'this is a scam'. Categories grounded in Scamwatch's published scam types and the NASC top-loss categories (investment, romance, payment redirection, remote access, phishing).",
  "severity_meaning": {
    "high": "Rarely appears in legitimate messages. Strong signal on its own.",
    "medium": "Common in scams but also appears legitimately. Meaningful in combination.",
    "low": "Weak on its own; only reported when other rules also match.",
    "corroboration": "Rules with requires_corroboration only report when one of their combine_with rules also fired. Naming an organisation is not suspicious; naming one alongside a deadline and an off-domain link is."
  },
  "rules": [
    {
      "id": "payment.gift_card",
      "category": "payment_method",
      "severity": "high",
      "title": "Asks you to pay with gift cards",
      "plain_explanation": "No real business, government office or bank will ever ask you to pay with gift cards or store cards. This is one of the clearest signs of a scam there is.",
      "patterns": [
        {
          "type": "regex",
          "value": "\\b(gift|itunes|google play|steam|apple|prepaid|voucher)\\s*(card|cards|voucher|vouchers)\\b"
        },
        {
          "type": "regex",
          "value": "\\bload (the )?(funds|money|amount) onto\\b"
        }
      ],
      "practice_scenario_id": null,
      "sources": [
        "scamwatch:threat-scams",
        "scamwatch:unexpected-money-scams"
      ]
    },
    {
      "id": "payment.crypto",
      "category": "payment_method",
      "severity": "high",
      "title": "Asks you to pay in cryptocurrency",
      "plain_explanation": "Government departments, banks and delivery companies do not accept Bitcoin or other cryptocurrency. Once crypto is sent it cannot be recovered, which is exactly why scammers ask for it.",
      "patterns": [
        {
          "type": "regex",
          "value": "\\b(bitcoin|btc|ethereum|eth|usdt|crypto(currency)?|blockchain wallet|cold wallet)\\b"
        },
        {
          "type": "regex",
          "value": "\\b(crypto|bitcoin)\\s*(atm|machine|kiosk)\\b"
        }
      ],
      "practice_scenario_id": null,
      "sources": [
        "nasc:investment-scams",
        "scamwatch:investment-scams"
      ]
    },
    {
      "id": "payment.account_change",
      "category": "payment_redirection",
      "severity": "high",
      "title": "Says bank details have changed",
      "plain_explanation": "A message saying an invoice should now be paid to different bank details is the classic payment redirection scam. Always ring the business on a number you already have — never the one in the message — before paying.",
      "patterns": [
        {
          "type": "regex",
          "value": "\\b(our|the|new|updated|changed)\\s+(bank|account|banking|payment)\\s+(details|account|number|information)\\b"
        },
        {
          "type": "regex",
          "value": "\\bbsb\\b.{0,40}\\b(changed|updated|new)\\b"
        },
        {
          "type": "regex",
          "value": "\\b(please )?(use|note|update to) (the )?(new|updated) (account|bsb|bank)\\b"
        }
      ],
      "practice_scenario_id": null,
      "sources": [
        "nasc:payment-redirection",
        "scamwatch:business-email-compromise"
      ]
    },
    {
      "id": "access.remote_software",
      "category": "remote_access",
      "severity": "high",
      "title": "Wants to connect to your device",
      "plain_explanation": "Asking you to install software so a 'technician' can connect to your computer or phone hands them full control. Real support from your bank or telco will never start with an unexpected call asking for this.",
      "patterns": [
        {
          "type": "regex",
          "value": "\\b(anydesk|teamviewer|ultraviewer|quick ?support|logmein|remote ?desktop|screen ?share)\\b"
        },
        {
          "type": "regex",
          "value": "\\b(allow|let|grant) (me|us|our technician|the technician) (to )?(access|connect to|control)\\b"
        },
        {
          "type": "regex",
          "value": "\\binstall (this|the|our) (app|software|program) so (we|i) can\\b"
        }
      ],
      "practice_scenario_id": null,
      "sources": [
        "nasc:remote-access-scams",
        "scamwatch:threat-scams"
      ]
    },
    {
      "id": "creds.request",
      "category": "phishing",
      "severity": "high",
      "title": "Asks for passwords, PINs or codes",
      "plain_explanation": "No legitimate organisation will ever ask you for your password, PIN, or the one-time code they just sent you. Anyone asking for that code is trying to get into your account right now.",
      "patterns": [
        {
          "type": "regex",
          "value": "\\b(confirm|verify|provide|enter|send|share|read (me|out)|tell (me|us))\\b.{0,30}\\b(password|passcode|pin|otp|one[- ]time (code|password)|security code|verification code)\\b"
        },
        {
          "type": "regex",
          "value": "\\b(full )?(card|credit card|debit card) number\\b"
        },
        {
          "type": "regex",
          "value": "\\bmygov (sign[- ]?in|login|log[- ]?in) details\\b"
        }
      ],
      "practice_scenario_id": null,
      "sources": [
        "scamwatch:phishing",
        "scamwatch:ato-mygov-impersonation"
      ]
    },
    {
      "id": "impersonation.gov",
      "category": "impersonation",
      "severity": "medium",
      "title": "Claims to be from a government service",
      "plain_explanation": "myGov, the ATO, Medicare and Centrelink never send links in unexpected texts or emails. If you think it might be real, close the message and go to the official website or app yourself.",
      "patterns": [
        {
          "type": "regex",
          "value": "\\b(mygov|my ?gov|ato|australian taxation office|centrelink|medicare|services australia)\\b"
        }
      ],
      "combine_with": [
        "link.present",
        "link.shortener",
        "link.non_official_domain",
        "urgency.deadline",
        "creds.request",
        "pressure.threat",
        "money.unexpected"
      ],
      "practice_scenario_id": null,
      "sources": [
        "scamwatch:ato-mygov-impersonation"
      ],
      "requires_corroboration": true
    },
    {
      "id": "impersonation.delivery",
      "category": "impersonation",
      "severity": "medium",
      "title": "Claims to be a delivery company",
      "plain_explanation": "Fake delivery texts are one of the most common scams in Australia. Real couriers use their own app or website — check your tracking there rather than tapping a link in a message.",
      "patterns": [
        {
          "type": "regex",
          "value": "\\b(auspost|australia ?post|startrack|dhl|fedex|toll|couriers ?please|aramex|linkt)\\b"
        },
        {
          "type": "regex",
          "value": "\\b(parcel|package|delivery|shipment)\\b.{0,60}\\b(held|pending|failed|unable to deliver|redeliver|customs|fee|surcharge)\\b"
        }
      ],
      "combine_with": [
        "link.present",
        "link.shortener",
        "link.non_official_domain",
        "urgency.deadline",
        "payment.gift_card"
      ],
      "practice_scenario_id": null,
      "sources": [
        "scamwatch:text-or-sms-scams"
      ],
      "requires_corroboration": true
    },
    {
      "id": "impersonation.bank",
      "category": "impersonation",
      "severity": "medium",
      "title": "Claims to be your bank",
      "plain_explanation": "Banks do send security alerts, but they never ask you to move money to a 'safe account' or read out a code. Hang up and ring the number on the back of your card.",
      "patterns": [
        {
          "type": "regex",
          "value": "\\b(commbank|commonwealth bank|westpac|nab|anz|bankwest|ing|macquarie bank|suncorp bank|bendigo bank)\\b"
        },
        {
          "type": "regex",
          "value": "\\b(safe|secure|holding) account\\b"
        },
        {
          "type": "regex",
          "value": "\\b(unusual|suspicious|unauthorised) (activity|transaction|login|sign[- ]?in)\\b"
        }
      ],
      "combine_with": [
        "link.present",
        "link.shortener",
        "link.non_official_domain",
        "urgency.deadline",
        "creds.request",
        "pressure.secrecy",
        "access.remote_software"
      ],
      "practice_scenario_id": null,
      "sources": [
        "scamwatch:phishing",
        "nasc:phone-scams"
      ],
      "requires_corroboration": true
    },
    {
      "id": "urgency.deadline",
      "category": "pressure",
      "severity": "medium",
      "title": "Pushes you to act immediately",
      "plain_explanation": "Scams work by rushing you so you don't stop to check. A real organisation will still be there tomorrow. Any message that says you must act within hours deserves more suspicion, not less.",
      "patterns": [
        {
          "type": "regex",
          "value": "\\bwithin (the next )?\\d+\\s*(minutes?|hours?|hrs?|days?)\\b"
        },
        {
          "type": "regex",
          "value": "\\b(immediate(ly)?|urgent(ly)?|right away|as soon as possible|asap|final (notice|warning|reminder)|last chance|act now|expires (today|tonight|soon))\\b"
        },
        {
          "type": "regex",
          "value": "\\b(will be|has been) (suspended|deactivated|closed|locked|restricted|cancelled)\\b"
        }
      ],
      "practice_scenario_id": null,
      "sources": [
        "scamwatch:text-or-sms-scams",
        "scamwatch:ato-mygov-impersonation"
      ]
    },
    {
      "id": "pressure.threat",
      "category": "pressure",
      "severity": "high",
      "title": "Threatens you with arrest, fines or legal action",
      "plain_explanation": "Australian government agencies do not threaten arrest by text message or phone call, and they never demand instant payment to avoid it. This is a threat scam.",
      "patterns": [
        {
          "type": "regex",
          "value": "\\b(arrest|warrant|police|court|prosecut(e|ion)|legal action|deportation|visa (cancel|cancellation))\\b"
        },
        {
          "type": "regex",
          "value": "\\b(fine|penalty|debt)\\b.{0,50}\\b(pay|payment|immediately|today)\\b"
        }
      ],
      "practice_scenario_id": null,
      "sources": [
        "scamwatch:threat-scams"
      ]
    },
    {
      "id": "pressure.secrecy",
      "category": "pressure",
      "severity": "high",
      "title": "Tells you to keep it secret",
      "plain_explanation": "Any message telling you not to discuss this with your family, your bank or the police is trying to cut you off from the people who would spot the scam. This is a serious warning sign.",
      "patterns": [
        {
          "type": "regex",
          "value": "\\b(don'?t|do not) (tell|discuss|mention|inform|talk to)\\b.{0,40}\\b(anyone|family|bank|police|staff|son|daughter)\\b"
        },
        {
          "type": "regex",
          "value": "\\b(keep|this is) (this )?(confidential|between us|a secret)\\b"
        }
      ],
      "practice_scenario_id": null,
      "sources": [
        "scamwatch:threat-scams",
        "nasc:romance-scams"
      ]
    },
    {
      "id": "channel.switch",
      "category": "channel_switch",
      "severity": "medium",
      "title": "Moves you to another number or app",
      "plain_explanation": "Scammers move the conversation to WhatsApp or a phone number they control, away from the official channel where they could be traced or checked.",
      "patterns": [
        {
          "type": "regex",
          "value": "\\b(message|contact|text|reach|add) (me|us) on (whatsapp|telegram|signal|wechat|viber)\\b"
        },
        {
          "type": "regex",
          "value": "\\b(call|phone|ring|dial) (this|the following|us on|me on)\\b.{0,20}(\\+?\\d[\\d\\s\\-()]{7,})"
        }
      ],
      "practice_scenario_id": null,
      "sources": [
        "scamwatch:relationship-scams",
        "nasc:phone-scams"
      ]
    },
    {
      "id": "family.impersonation",
      "category": "impersonation",
      "severity": "high",
      "title": "Claims to be family from a new number",
      "plain_explanation": "The 'Hi Mum' scam: a message from an unknown number claiming to be your child who has lost their phone and urgently needs money. Ring your family member on their usual number before doing anything.",
      "patterns": [
        {
          "type": "regex",
          "value": "\\b(hi|hey|hello) (mum|mom|dad|nan|nana|pop|grandma|grandad)\\b"
        },
        {
          "type": "regex",
          "value": "\\b(lost|broke|smashed|dropped) my phone\\b"
        },
        {
          "type": "regex",
          "value": "\\b(this is|it'?s) my new number\\b"
        }
      ],
      "practice_scenario_id": null,
      "sources": [
        "scamwatch:text-or-sms-scams"
      ],
      "min_pattern_matches": 2
    },
    {
      "id": "money.unexpected",
      "category": "unexpected_money",
      "severity": "medium",
      "title": "Offers money you weren't expecting",
      "plain_explanation": "Unexpected refunds, rebates, prizes or inheritances are used to get you to hand over bank details. If you didn't enter, you didn't win.",
      "patterns": [
        {
          "type": "regex",
          "value": "\\b(you (have|'ve) (won|been selected)|congratulations|lucky winner|prize|lottery|inheritance)\\b"
        },
        {
          "type": "regex",
          "value": "\\b(refund|rebate|compensation|overpayment|credit) (of |is |due|owed|available|pending)\\b"
        }
      ],
      "combine_with": [
        "link.present",
        "creds.request"
      ],
      "practice_scenario_id": null,
      "sources": [
        "scamwatch:unexpected-money-scams"
      ]
    },
    {
      "id": "job.too_good",
      "category": "employment",
      "severity": "medium",
      "title": "Offers easy, high-paying work",
      "plain_explanation": "Job offers promising large daily earnings for simple tasks — especially ones that arrive unsolicited or ask you to pay a fee first — are recruitment into scams or money laundering.",
      "patterns": [
        {
          "type": "regex",
          "value": "\\b(earn|make|up to) \\$?\\d+[\\d,]*\\s*(per|a|\\/)\\s*(day|hour|week)\\b"
        },
        {
          "type": "regex",
          "value": "\\b(no experience|work from home|flexible hours|part[- ]?time)\\b.{0,60}\\b(guaranteed|easy|simple|daily pay)\\b"
        },
        {
          "type": "regex",
          "value": "\\b(training|registration|admin|onboarding) fee\\b"
        }
      ],
      "practice_scenario_id": null,
      "sources": [
        "scamwatch:jobs-and-employment-scams"
      ]
    },
    {
      "id": "link.shortener",
      "category": "link",
      "severity": "medium",
      "title": "Uses a shortened or hidden link",
      "plain_explanation": "Shortened links hide where they actually take you. Legitimate government and bank messages don't need to hide their web address.",
      "patterns": [
        {
          "type": "regex",
          "value": "\\b(bit\\.ly|tinyurl\\.com|t\\.co|goo\\.gl|ow\\.ly|is\\.gd|buff\\.ly|cutt\\.ly|rb\\.gy|shorturl\\.at)\\b"
        }
      ],
      "practice_scenario_id": null,
      "sources": [
        "scamwatch:phishing"
      ]
    },
    {
      "id": "link.non_official_domain",
      "category": "link",
      "severity": "medium",
      "title": "Link doesn't go to the real website",
      "plain_explanation": "The message names an organisation but its link goes to a different website. Real myGov links go to my.gov.au, and real Australia Post links go to auspost.com.au. Close the message and go to the official site yourself.",
      "practice_scenario_id": null,
      "sources": [
        "scamwatch:ato-mygov-impersonation"
      ],
      "match_type": "brand_domain_mismatch"
    },
    {
      "id": "link.present",
      "category": "link",
      "severity": "low",
      "title": "Contains a link",
      "plain_explanation": "A link on its own is normal. It matters more when the message is also unexpected, urgent, or claims to be from a government service.",
      "patterns": [
        {
          "type": "regex",
          "value": "https?:\\/\\/[^\\s]+"
        },
        {
          "type": "regex",
          "value": "\\b[a-z0-9-]+\\.(com|net|org|au|io|co)\\/[^\\s]*"
        }
      ],
      "report_alone": false,
      "practice_scenario_id": null,
      "sources": []
    },
    {
      "id": "greeting.generic",
      "category": "style",
      "severity": "low",
      "title": "Doesn't use your name",
      "plain_explanation": "Organisations that already know you usually use your name. 'Dear Customer' from your own bank is worth a second look — though plenty of real marketing does this too.",
      "patterns": [
        {
          "type": "regex",
          "value": "\\b(dear|hello|hi) (customer|user|client|sir\\/madam|account holder|member)\\b"
        }
      ],
      "report_alone": false,
      "practice_scenario_id": null,
      "sources": [
        "scamwatch:phishing"
      ]
    }
  ],
  "brand_domains": {
    "mygov": {
      "mentions": "\\b(mygov|my ?gov)\\b",
      "domains": [
        "my.gov.au",
        "servicesaustralia.gov.au"
      ]
    },
    "ato": {
      "mentions": "\\b(ato|australian taxation office)\\b",
      "domains": [
        "ato.gov.au"
      ]
    },
    "medicare": {
      "mentions": "\\bmedicare\\b",
      "domains": [
        "servicesaustralia.gov.au",
        "my.gov.au"
      ]
    },
    "centrelink": {
      "mentions": "\\bcentrelink\\b",
      "domains": [
        "servicesaustralia.gov.au",
        "my.gov.au"
      ]
    },
    "auspost": {
      "mentions": "\\b(auspost|australia ?post)\\b",
      "domains": [
        "auspost.com.au"
      ]
    },
    "linkt": {
      "mentions": "\\blinkt\\b",
      "domains": [
        "linkt.com.au"
      ]
    },
    "commbank": {
      "mentions": "\\b(commbank|commonwealth bank)\\b",
      "domains": [
        "commbank.com.au"
      ]
    },
    "westpac": {
      "mentions": "\\bwestpac\\b",
      "domains": [
        "westpac.com.au"
      ]
    },
    "nab": {
      "mentions": "\\bnab\\b",
      "domains": [
        "nab.com.au"
      ]
    },
    "anz": {
      "mentions": "\\banz\\b",
      "domains": [
        "anz.com",
        "anz.com.au"
      ]
    }
  }
}